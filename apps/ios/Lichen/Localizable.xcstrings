    "An X25519 / Ed25519 key made on this phone. It never leaves it: your radio only carries the messages.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé X25519 / Ed25519 générée sur ce téléphone. Elle ne le quitte jamais : ta radio ne fait que transporter les messages."
          }
        }
      }
    },
