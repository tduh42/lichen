    "Stock companion firmware does not repeat: a repeater node does that.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le firmware companion stock ne relaie pas : c'est le rôle d'un nœud répéteur."
          }
        }
      }
    },
    "Stop": {
