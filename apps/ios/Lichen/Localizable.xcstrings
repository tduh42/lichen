    "This is not a lichen code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un code lichen."
          }
        }
      }
    },
    "Thumbnail now, full resolution later": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miniature + pleine résolution plus tard"
