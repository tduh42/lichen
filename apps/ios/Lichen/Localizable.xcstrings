    "EU rules cap each node's time on air. lichen counts its own transmissions and waits when the budget is spent.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réglementation européenne plafonne le temps d'antenne de chaque nœud. lichen compte ses propres émissions et attend quand le budget est épuisé."
          }
        }
      }
    },
