    },
    "Someone using %@'s radio": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un qui utilise la radio de %@"
          }
        }
      }
    },
    "Someone using %@'s radio wants to write to you": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un qui utilise la radio de %@ veut t'écrire"
          }
        }
      }
    },
    "Someone with the stock MeshCore app can scan it to add this radio.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec l’app MeshCore d’origine, on peut le scanner pour ajouter cette radio."
