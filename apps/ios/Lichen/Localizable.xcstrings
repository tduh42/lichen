        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayer"
          }
        }
      }
    },
    "Try the demo network": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayer le réseau de démo"
          }
        }
      }
    },
    "Try the demo network instead": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayer plutôt le réseau de démo"
          }
        }
      }
    },
    "Turn Bluetooth on to reach your radio.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active le Bluetooth pour joindre ta radio."
          }
        }
      }
    },
    "Turn Tor on in Settings": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active Tor dans les Réglages"
          }
        }
      }
    },
    "Turn it off to see messages wait for the radio.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éteins-la pour voir les messages attendre la radio."
          }
        }
      }
    },
    "Turn your radio on and keep it close to the phone. Stock MeshCore companion firmware: nothing to flash.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allume ta radio et garde-la près du téléphone. Firmware MeshCore companion stock : rien à flasher."
          }
        }
      }
    },
    "Type the 24 words of the identity to restore, separated by spaces. It replaces the identity on this phone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tape les 24 mots de l'identité à restaurer, séparés par des espaces. Elle remplace l'identité de ce téléphone."
          }
        }
      }
    },
    "Unknown contact.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact inconnu."
          }
        }
      }
    },
    "Unknown group.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Groupe inconnu."
          }
        }
      }
    },
    "Unsupported content (type %@, %@ bytes)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu non pris en charge (type %@, %@ octets)"
          }
        }
      }
    },
    "Update": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à jour"
          }
        }
      }
    },
    "Use %@ again": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprendre %@"
          }
        }
      }
    },
    "Use this direction": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser cette direction"
          }
        }
      }
    },
    "Verified by the scan. Their phone shows the same numbers once it knows you: after your first message, or when they scan your code.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifié par le scan. Son téléphone affiche les mêmes chiffres dès qu'il te connaît : après ton premier message, ou quand il scanne ton code."
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "Voice message (%@)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Message vocal (%@)"
          }
        }
      }
    },
    "Voice messages": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages vocaux"
          }
        }
      }
    },
    "Waiting for GPS": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente du GPS"
          }
        }
      }
    },
    "Waiting for airtime · around %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de temps d'antenne · vers %@"
          }
        }
      }
    },
    "Waiting for sender keys": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sender keys en attente"
          }
        }
      }
    },
    "Waiting for the acknowledgement": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de l'ACK"
          }
        }
      }
    },
    "Waiting for the radio · expires in %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la radio · expire dans %@"
          }
        }
      }
    },
    "Waiting for your position": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de ta position"
          }
        }
      }
    },
    "Waiting to be sent": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d'envoi"
          }
        }
      }
    },
    "What is sent": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui sera envoyé"
          }
        }
      }
    },
    "What is stored on this phone is not a valid identity. Restore it from its 24 words, or start a new identity.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui est enregistré sur ce téléphone n’est pas une identité valide. Restaure-la depuis ses 24 mots, ou crée une nouvelle identité."
          }
        }
      }
    },
    "When a member of your groups sends an SOS, follow it here, with or without their GPS. To search for someone else, open a group and choose them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un membre de tes groupes envoie un SOS, suis-le ici, avec ou sans GPS. Pour rechercher quelqu’un d’autre, ouvre un groupe et choisis la personne."
          }
        }
      }
    },
    "When you pair, iOS asks for the 6 digits shown on the radio's screen: type them in its prompt. The radio then stays paired with this phone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À l'appairage, iOS demande les 6 chiffres affichés sur l'écran de la radio : saisis-les dans sa fenêtre. La radio reste ensuite appairée à ce téléphone."
          }
        }
      }
    },
    "Within %@ of here, around you. Move a few hundred metres or add a bearing: other places narrow it down.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À moins de %@ d’ici, tout autour. Déplace-toi de quelques centaines de mètres ou ajoute un relèvement : d’autres endroits affinent la zone."
          }
        }
      }
    },
    "Without a backup, losing this phone means losing your identity and your verified contacts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans sauvegarde, perdre ce téléphone, c'est perdre ton identité et tes contacts vérifiés."
          }
        }
      }
    },
    "Write these 24 words on paper, in order, and keep them somewhere safe. Anyone who has them can be you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écris ces 24 mots sur papier, dans l'ordre, et garde-les en lieu sûr. Qui les a peut se faire passer pour toi."
          }
        }
      }
    },
    "Written while my radio is off": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrit pendant que ma radio est éteinte"
          }
        }
      }
    },
    "Yesterday": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier"
          }
        }
      }
    },
    "You": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toi"
          }
        }
      }
    },
    "You scanned their code in person.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as scanné son code en personne."
          }
        }
      }
    },
    "You stop receiving its messages and your location shares with it stop. What you received stays on this phone.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ne reçois plus ses messages et tes partages de position avec lui s’arrêtent. Ce que tu as reçu reste sur ce téléphone."
          }
        }
      }
    },
    "Your code carries your radio's address, so people can reach you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton code contient l'adresse de ta radio, pour qu'on puisse te joindre."
          }
        }
      }
    },
    "Your contact code": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton code de contact"
          }
        }
      }
    },
    "Your contacts will see a new identity and will have to verify you again. Restore your 24 words instead if you have them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes contacts verront une nouvelle identité et devront te vérifier à nouveau. Si tu as tes 24 mots, restaure-les plutôt."
          }
        }
      }
    },
    "Your cost: %@ · ≈ %@ s of airtime · relays add theirs, no acknowledgement": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton coût : %@ · ≈ %@ s d’antenne · les relais ajoutent le leur, sans accusé de réception"
          }
        }
      }
    },
    "Your exact GPS position, again every 2 minutes. Without GPS, a beacon your groups can locate by radio.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position GPS exacte, toutes les 2 minutes. Sans GPS, une balise que tes groupes peuvent localiser par radio."
          }
        }
      }
    },
    "Your identity": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton identité"
          }
        }
      }
    },
    "Your identity can’t be used right now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton identité est inutilisable pour le moment"
          }
        }
      }
    },
    "Your key's fingerprint": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empreinte de ta clé"
          }
        }
      }
    },
    "Your last reading: %d dBm, %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta dernière mesure : %d dBm, %@"
          }
        }
      }
    },
    "Your name": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton nom"
          }
        }
      }
    },
    "Your new identity could not be saved on this phone. Try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta nouvelle identité n’a pas pu être enregistrée sur ce téléphone. Réessaie."
          }
        }
      }
    },
    "Your onion service is reachable": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton service onion est joignable"
          }
        }
      }
    },
    "Your phone answers their pings: SOS, or you let the group locate you.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton téléphone répond à leurs pings : SOS, ou tu laisses le groupe te localiser."
          }
        }
      }
    },
    "Your phone answers their search pings even outside SOS": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton téléphone répond à leurs pings de recherche, même hors SOS"
          }
        }
      }
    },
    "Your position is not known yet": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position n'est pas encore connue"
          }
        }
      }
    },
    "Your position is not known yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta position n’est pas encore connue."
          }
        }
      }
    },
    "Your radio measures each of their transmissions it hears directly, where you stand; the group shares its measures and every phone works out where they probably are.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta radio mesure chaque émission qu’elle entend directement, là où tu es ; le groupe partage ses mesures et chaque téléphone calcule où la personne se trouve probablement."
          }
        }
      }
    },
    "Your radio transmits at %d dBm for the search, then goes back.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta radio émet à %d dBm pour la recherche, puis revient à la normale."
          }
        }
      }
    },
