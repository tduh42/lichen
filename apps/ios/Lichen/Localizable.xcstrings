        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes discussions lichen avec les mêmes personnes restent chiffrées de bout en bout ; rien n'en passe jamais dans une discussion MeshCore."
          }
        }
      }
    },
    "lichen is free software under the GNU General Public License, version 3 or later: you may use it, study it, share it and change it. Its source code is on GitHub.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "lichen est un logiciel libre sous licence publique générale GNU, version 3 ou ultérieure : tu peux l’utiliser, l’étudier, le partager et le modifier. Son code source est sur GitHub."
