    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Location permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "lichen sends your position, encrypted, to the people and groups you share it with, and shows you on the map." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "lichen envoie ta position, chiffrée, aux personnes et aux groupes avec qui tu la partages, et te montre sur la carte." } }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local network permission prompt",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "lichen reaches a MeshCore radio on your network: one on Wi-Fi, or one a computer relays." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "lichen joint une radio MeshCore sur ton réseau : en Wi-Fi, ou relayée par un ordinateur." } }
      }
